# Copiá este archivo a .env.local y completá con los datos del proyecto Supabase.
# Estos valores son públicos por diseño (clave anónima + RLS). No pongas acá
# la service_role ni secretos de servidor.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# URL pública de la app. En Vercel usá el dominio de producción.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
